# 환경변수 목록 (API_SPEC §8.3). 이 파일에는 이름만 두고, 값은 절대 적지 않는다.
# 사용법: 이 파일을 복사해 .env.local 을 만들고, = 뒤에 값을 붙여넣는다 (.env.local 은 저장소에 올라가지 않음).
# NEXT_PUBLIC_ 으로 시작하는 값은 브라우저에 공개된다. 🔒 비밀 키에는 절대 붙이지 않는다.

# Supabase — 로컬·Preview는 sleepyheads-dev, Production은 sleepyheads-prod
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 🔒 서버 전용
SUPABASE_SECRET_KEY=

# 🔒 OpenDART — 로컬은 각자 본인 명의 키
OPENDART_API_KEY=

# 🔒 공공데이터포털 금융위원회_주식시세정보 (Step 5)
DATA_GO_KR_SERVICE_KEY=

# 🔒 네이버 검색 API (Step 3)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 🔒 OpenAI — 팀 키 1개 공유 (월 예산 상한 설정 필수)
OPENAI_API_KEY=
# 기본값 gpt-6-luna
OPENAI_MODEL=

# 🔒 Vercel Cron 호출 인증 — 16자 이상 무작위 문자열
CRON_SECRET=
