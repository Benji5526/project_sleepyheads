# 환경변수 목록 — 기준: DevelopDoc/API_SPEC.md §8.3
# 이 파일을 .env.local로 복사한 뒤 값을 채운다. 실제 키를 이 파일에 적어 커밋하지 않는다.
# NEXT_PUBLIC_ 접두사가 붙은 변수만 브라우저에 공개된다. 서버 전용 키에는 절대 붙이지 않는다.

# Supabase (로컬·Preview = sleepyheads-dev, Production = sleepyheads-prod)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 외부 데이터 (로컬은 각자 본인 명의 키)
OPENDART_API_KEY=
DATA_GO_KR_SERVICE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenAI (팀 키 공유, 기본 모델 gpt-6-luna)
OPENAI_API_KEY=
OPENAI_MODEL=

# Vercel Cron 호출 인증 (16자 이상 무작위 문자열)
CRON_SECRET=
