# API_SPEC §8.3 — 이 파일을 .env.local로 복사해 값을 채운다. 값은 절대 커밋하지 않는다.
# 🔒 표시는 서버 전용 키: NEXT_PUBLIC_ 접두어를 붙이지 않는다.

# Supabase (로컬·Preview = sleepyheads-dev, Production = sleepyheads-prod)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 외부 데이터 (로컬은 본인 명의 키) 🔒
OPENDART_API_KEY=
DATA_GO_KR_SERVICE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenAI (팀 키) 🔒
OPENAI_API_KEY=
OPENAI_MODEL=

# Vercel Cron 인증 (16자 이상 무작위 문자열) 🔒
CRON_SECRET=
